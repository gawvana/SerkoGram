// SerkoGram Database Schema
// PostgreSQL via Prisma ORM
// Canonical Schema v2 strictly conforming to Telegram Bot API 10.3 Chat Automation Spec

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum ConnectionStatus {
  CONNECTED
  ACTIVE
  DISCONNECTED
  PAUSED
  ERROR
  WAITING_FOR_EVENT
}

enum MediaStatus {
  PENDING
  SAVED
  UNAVAILABLE
  FAILED
}

enum MessageType {
  TEXT
  PHOTO
  VIDEO
  DOCUMENT
  AUDIO
  VOICE
  VIDEO_NOTE
  STICKER
  ANIMATION
  CONTACT
  LOCATION
  VENUE
  POLL
  DICE
  SERVICE
  UNKNOWN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketCategory {
  BUG
  CONNECTION
  ARCHIVE
  PAYMENT
  SUGGESTION
  OTHER
}

enum RetentionPeriod {
  DAYS_7
  DAYS_30
  DAYS_90
  YEAR_1
  FOREVER
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  CONNECTION_CREATED
  CONNECTION_DELETED
  MESSAGE_ARCHIVED
  MESSAGE_DELETED
  MEDIA_UPLOADED
  MEDIA_DELETED
  SETTINGS_CHANGED
  PRIVACY_CHANGED
  ARCHIVE_DELETED
  ACCOUNT_DELETED
  TICKET_CREATED
  TICKET_UPDATED
  ADMIN_ACTION
}

enum ArchiveStatus {
  AVAILABLE
  ARCHIVED
  UNAVAILABLE
  FAILED
  EXPIRED_BEFORE_ARCHIVE
}

enum CommandExecutionStatus {
  RECEIVED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum NotificationType {
  ARCHIVE_SUCCESS
  MEDIA_SAVED
  EPHEMERAL_SAVED
  ARCHIVE_FAILURE
  MESSAGE_DELETED
  MESSAGE_EDITED
  COMMAND_RESULT
  ACCOUNT_CONNECTED
  ACCOUNT_DISCONNECTED
  PERMISSION_CHANGED
  ARCHIVE_UPDATED
  AUTOMATION_ERROR
  TIMER_COMPLETED
  SYSTEM
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id                String               @id @default(cuid())
  telegramId        BigInt               @unique @map("telegram_id")
  firstName         String               @map("first_name")
  lastName          String?              @map("last_name")
  username          String?
  languageCode      String?              @map("language_code")
  photoUrl          String?              @map("photo_url")
  isPremium         Boolean              @default(false) @map("is_premium")
  telegramPremium   Boolean?             @map("telegram_premium")
  isAdmin           Boolean              @default(false) @map("is_admin")
  lastLoginAt       DateTime             @default(now()) @map("last_login_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  settings          UserSettings?
  privacySettings   PrivacySettings?
  connections       BusinessConnection[]
  commandExecutions CommandExecution[]
  tickets           SupportTicket[]
  auditLogs         AuditLog[]
  notifications     OwnerNotification[]

  @@map("users")
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  autoSaveEnabled     Boolean  @default(true) @map("auto_save_enabled")
  saveMessages        Boolean  @default(true) @map("save_messages")
  saveMedia           Boolean  @default(true) @map("save_media")
  saveEdits           Boolean  @default(true) @map("save_edits")
  saveDeleted         Boolean  @default(true) @map("save_deleted")
  notificationsOn     Boolean  @default(false) @map("notifications_on")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model PrivacySettings {
  id              String          @id @default(cuid())
  userId          String          @unique @map("user_id")
  retention       RetentionPeriod @default(FOREVER)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

// ============================================================
// CONNECTIONS (CANONICAL)
// ============================================================

model BusinessConnection {
  id                   String           @id @default(cuid())
  telegramConnectionId String           @unique @map("telegram_connection_id")
  telegramUserId       BigInt           @default(0) @map("telegram_user_id")
  userChatId           BigInt           @default(0) @map("user_chat_id")
  botId                String           @default("") @map("bot_id")
  type                 String?          @default("BUSINESS")
  connectionMode       String?          @default("AUTOMATION_CHAT") @map("connection_mode")
  isEnabled            Boolean          @default(true) @map("is_enabled")
  status               ConnectionStatus @default(WAITING_FOR_EVENT)
  rights               Json             @default("{}") // Raw BusinessBotRights snapshot
  canReply             Boolean?         @default(true) @map("can_reply")
  canReadMessages      Boolean?         @default(true) @map("can_read_messages")
  canDeleteSentMessages Boolean?        @default(true) @map("can_delete_sent_messages")
  canDeleteAllMessages Boolean?         @default(false) @map("can_delete_all_messages")
  telegramPremium      Boolean?         @map("telegram_premium")
  connectedAt          DateTime?        @map("connected_at")
  disconnectedAt       DateTime?        @map("disconnected_at")
  lastSeenAt           DateTime?        @map("last_seen_at")
  lastEventAt          DateTime?        @map("last_event_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  userId               String           @map("user_id")
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats                Chat[]
  archiveMessages      ArchiveMessage[]

  @@index([telegramUserId])
  @@index([status])
  @@index([userId])
  @@map("business_connections")
}

// ============================================================
// CHATS
// ============================================================

model Chat {
  id                 String    @id @default(cuid())
  telegramChatId     BigInt    @map("telegram_chat_id")
  connectionId       String    @map("connection_id")
  title              String?
  chatType           String    @default("private") @map("chat_type")
  photoUrl           String?   @map("photo_url")
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview")
  totalMessages      Int       @default(0) @map("total_messages")
  deletedMessages    Int       @default(0) @map("deleted_messages")
  editedMessages     Int       @default(0) @map("edited_messages")
  mediaCount         Int       @default(0) @map("media_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  connection      BusinessConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  members         ChatMember[]
  messages        Message[]
  archiveMessages ArchiveMessage[]

  @@unique([telegramChatId, connectionId])
  @@index([connectionId])
  @@index([lastMessageAt])
  @@map("chats")
}

model ChatMember {
  id             String   @id @default(cuid())
  chatId         String   @map("chat_id")
  telegramUserId BigInt   @map("telegram_user_id")
  firstName      String   @map("first_name")
  lastName       String?  @map("last_name")
  username       String?
  photoUrl       String?  @map("photo_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, telegramUserId])
  @@index([telegramUserId])
  @@map("chat_members")
}

// ============================================================
// ARCHIVE (CANONICAL §5)
// ============================================================

model ArchiveMessage {
  id                   String             @id @default(cuid())
  connectionId         String             @map("connection_id")
  telegramChatId       BigInt             @map("telegram_chat_id")
  telegramMessageId    BigInt             @map("telegram_message_id")
  businessConnectionId String             @map("business_connection_id")
  senderTelegramId     BigInt?            @map("sender_telegram_id")
  senderName           String?            @map("sender_name")
  senderUsername       String?            @map("sender_username")
  isOutgoing           Boolean            @default(false) @map("is_outgoing")
  messageType          String             @default("TEXT") @map("message_type")
  text                 String?
  caption              String?
  entities             Json?
  replyToMessageId     BigInt?            @map("reply_to_message_id")
  forwardFromName      String?            @map("forward_from_name")
  telegramDate         DateTime           @map("telegram_date")
  editedAt             DateTime?          @map("edited_at")
  deletedAt            DateTime?          @map("deleted_at")
  editHistory          Json?              // Snapshot array of { text, caption, editedAt }
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  chatId               String?            @map("chat_id")
  chat                 Chat?              @relation(fields: [chatId], references: [id], onDelete: SetNull)
  connection           BusinessConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  media                MediaAttachment[]

  @@unique([connectionId, telegramChatId, telegramMessageId])
  @@index([connectionId])
  @@index([telegramChatId])
  @@index([editedAt])
  @@index([deletedAt])
  @@map("archive_messages")
}

model MediaAttachment {
  id                   String         @id @default(cuid())
  archiveMessageId     String         @map("archive_message_id")
  telegramFileId       String         @map("telegram_file_id")
  telegramFileUniqueId String         @map("telegram_file_unique_id")
  storageKey           String?        @map("storage_key")
  storageUrl           String?        @map("storage_url")
  mimeType             String?        @map("mime_type")
  fileSize             Int?           @map("file_size")
  mediaType            String         @map("media_type")
  width                Int?
  height               Int?
  duration             Int?
  fileName             String?        @map("file_name")
  status               MediaStatus    @default(PENDING)
  errorCode            String?        @map("error_code")
  errorMessage         String?        @map("error_message")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  archiveMessage ArchiveMessage @relation(fields: [archiveMessageId], references: [id], onDelete: Cascade)

  @@index([archiveMessageId])
  @@index([telegramFileUniqueId])
  @@index([status])
  @@map("media_attachments")
}

// ============================================================
// LEGACY COMPATIBILITY MESSAGE MODELS (Scheduled for phase migration)
// ============================================================

model Message {
  id                   String           @id @default(cuid())
  chatId               String           @map("chat_id")
  telegramMessageId    Int              @map("telegram_message_id")
  businessConnectionId String?          @map("business_connection_id")
  senderTelegramId     BigInt?          @map("sender_telegram_id")
  senderName           String?          @map("sender_name")
  senderUsername       String?          @map("sender_username")
  isOutgoing           Boolean          @default(false) @map("is_outgoing")
  messageType          MessageType      @default(TEXT) @map("message_type")
  text                 String?
  caption              String?
  replyToMessageId     Int?             @map("reply_to_message_id")
  forwardFromName      String?          @map("forward_from_name")
  isEdited             Boolean          @default(false) @map("is_edited")
  editedAt             DateTime?        @map("edited_at")
  isDeleted            Boolean          @default(false) @map("is_deleted")
  deletedAt            DateTime?        @map("deleted_at")
  telegramDate         DateTime         @map("telegram_date")
  rawData              Json?            @map("raw_data")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  chat     Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  versions MessageVersion[]
  media    MessageMedia[]
  deletion MessageDeletion?

  @@unique([chatId, telegramMessageId])
  @@index([chatId, telegramDate])
  @@index([senderTelegramId])
  @@index([isDeleted])
  @@index([isEdited])
  @@index([messageType])
  @@index([businessConnectionId])
  @@index([chatId, isDeleted, telegramDate])
  @@map("messages")
}

model MessageVersion {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  version   Int
  text      String?
  caption   String?
  editedAt  DateTime @map("edited_at")
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, version])
  @@index([messageId])
  @@map("message_versions")
}

model MessageMedia {
  id                  String        @id @default(cuid())
  messageId           String        @map("message_id")
  telegramFileId      String        @map("telegram_file_id")
  fileUniqueId        String        @map("file_unique_id")
  mediaType           String        @map("media_type")
  fileName            String?       @map("file_name")
  mimeType            String?       @map("mime_type")
  fileSize            Int?          @map("file_size")
  width               Int?
  height              Int?
  duration            Int?
  storagePath         String?       @map("storage_path")
  storageUrl          String?       @map("storage_url")
  thumbnailPath       String?       @map("thumbnail_path")
  isDownloaded        Boolean       @default(false) @map("is_downloaded")
  isEphemeral         Boolean       @default(false) @map("is_ephemeral")
  isViewOnce          Boolean       @default(false) @map("is_view_once")
  ttlSeconds          Int?          @map("ttl_seconds")
  ephemeralDetectedAt DateTime?     @map("ephemeral_detected_at")
  archiveStatus       ArchiveStatus @default(AVAILABLE) @map("archive_status")
  archiveError        String?       @map("archive_error")
  archivedAt          DateTime?     @map("archived_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileUniqueId])
  @@index([messageId])
  @@index([fileUniqueId])
  @@index([isEphemeral])
  @@index([archiveStatus])
  @@map("message_media")
}

model MessageDeletion {
  id         String   @id @default(cuid())
  messageId  String   @unique @map("message_id")
  deletedAt  DateTime @map("deleted_at")
  detectedAt DateTime @default(now()) @map("detected_at")
  createdAt  DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_deletions")
}

// ============================================================
// COMMAND EXECUTIONS
// ============================================================

model CommandExecution {
  id                String                 @id @default(cuid())
  userId            String                 @map("user_id")
  chatId            String                 @map("chat_id")
  telegramMessageId Int                    @map("telegram_message_id")
  command           String
  prefix            String                 @default(".")
  arguments         String?
  replyToMessageId  Int?                   @map("reply_to_message_id")
  status            CommandExecutionStatus @default(RECEIVED)
  resultMessageId   Int?                   @map("result_message_id")
  errorCode         String?                @map("error_code")
  createdAt         DateTime               @default(now()) @map("created_at")
  completedAt       DateTime?              @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId, telegramMessageId])
  @@index([chatId])
  @@index([command])
  @@index([status])
  @@map("command_executions")
}

// ============================================================
// SUPPORT
// ============================================================

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  category  TicketCategory
  subject   String
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  closedAt  DateTime?      @map("closed_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  isSupport Boolean  @default(false) @map("is_support")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

// ============================================================
// AUDIT & SYSTEM
// ============================================================

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?     @map("user_id")
  action    AuditAction
  details   Json?
  ipAddress String?     @map("ip_address")
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ProcessedUpdate {
  id          String   @id @default(cuid())
  updateId    Int      @unique @map("update_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_updates")
}

// ============================================================
// OWNER NOTIFICATIONS (PRIVATE NOTIFICATION CENTER)
// ============================================================

model OwnerNotification {
  id             String             @id @default(cuid())
  userId         String             @map("user_id")
  telegramUserId BigInt             @map("telegram_user_id")
  connectionId   String?            @map("connection_id")
  dedupeKey      String?            @unique @map("dedupe_key")
  type           NotificationType
  title          String
  text           String
  chatId         String?            @map("chat_id")
  chatTitle      String?            @map("chat_title")
  messageId      Int?               @map("message_id")
  mediaId        String?            @map("media_id")
  mediaType      String?            @map("media_type")
  isEphemeral    Boolean            @default(false) @map("is_ephemeral")
  status         NotificationStatus @default(PENDING)
  error          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  readAt         DateTime?          @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([telegramUserId])
  @@index([connectionId])
  @@index([status])
  @@index([createdAt])
  @@map("owner_notifications")
}

model ChatAutomationSettings {
  id                String    @id @default(cuid())
  chatId            String    @unique // Internal DB chat id
  telegramChatId    BigInt
  autoTranslateLang String? // null = disabled, "en"/"ru"/etc = enabled
  muteEnabled       Boolean   @default(false)
  muteUntil         DateTime?
  panicEnabled      Boolean   @default(false)
  autoTypingEnabled Boolean   @default(false)
  warningThreshold  Int       @default(3)
  moderationEnabled Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ChatWarning {
  id               String   @id @default(cuid())
  chatId           String
  targetTelegramId BigInt
  reason           String?
  count            Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([chatId, targetTelegramId])
}

model ScheduledJob {
  id                   String   @id @default(cuid())
  type                 String // "TIMER", "REMINDER"
  chatId               String   @map("chat_id")
  telegramChatId       BigInt   @map("telegram_chat_id")
  businessConnectionId String?  @map("business_connection_id")
  userId               String?  @map("user_id")
  targetMessageId      Int?     @map("target_message_id")
  payload              String? // JSON stringified payload
  executeAt            DateTime @map("execute_at")
  status               String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  attempts             Int      @default(0)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([status, executeAt])
  @@map("scheduled_jobs")
}
