# SerkoGram Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ============================================================
# Telegram Bot
# ============================================================
TELEGRAM_BOT_TOKEN=<PASTE_BOT_TOKEN_HERE>
TELEGRAM_BOT_USERNAME=<PASTE_BOT_USERNAME_HERE>
TELEGRAM_WEBHOOK_SECRET=<GENERATE_RANDOM_SECRET_HERE>

# ============================================================
# Database (PostgreSQL via Neon or Vercel Postgres)
# ============================================================
# Pooled connection (for application queries)
DATABASE_URL=<PASTE_POOLED_DATABASE_URL_HERE>
# Direct connection (for migrations only)
DIRECT_URL=<PASTE_DIRECT_DATABASE_URL_HERE>

# ============================================================
# Application
# ============================================================
NEXT_PUBLIC_APP_URL=<PASTE_VERCEL_APP_URL_HERE>
SESSION_SECRET=<GENERATE_SECURE_RANDOM_SECRET_MIN_32_CHARS>

# ============================================================
# Media Storage (Vercel Blob)
# ============================================================
BLOB_READ_WRITE_TOKEN=<PASTE_VERCEL_BLOB_TOKEN_HERE>

# ============================================================
# Admin
# ============================================================
ADMIN_TELEGRAM_ID=<PASTE_ADMIN_TELEGRAM_ID_HERE>
